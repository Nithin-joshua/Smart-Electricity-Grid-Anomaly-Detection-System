# ==============================================================================
# Environment Variables Template — Smart Grid Anomaly Detection System
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# --- MQTT Broker ---
MQTT_HOST=localhost
MQTT_PORT=1883

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influxdb_token_here
INFLUX_ORG=smartgrid
INFLUX_BUCKET=meter_readings
INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=change_this_password
INFLUX_PORT=8086

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_password

# --- Alerting ---
ALERT_WEBHOOK_URL=http://localhost:9000/webhook/alerts
