# ==============================================================================
# .gitignore — Smart Electricity Grid Anomaly Detection System
# ==============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# --- Virtual Environments ---
venv/
.venv/
env/
.env/

# --- Environment Secrets ---
# .env contains local dev secrets (tokens, passwords).
# .env.example is the safe template and IS tracked.
.env
!.env.example

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Data Files ---
# Raw, processed, and Parquet datasets are too large for VCS.
data/raw/
data/processed/
data/normal_data/
*.parquet

# --- Model Artifacts ---
# Trained model weights, checkpoints, and logs.
# Regenerate via: python -m model.training.training_pipeline
model/artifacts/
!model/artifacts/.gitkeep

# --- Logs ---
*.log
logs/
training_logs/

# --- Docker ---
# Ignore persistent volume data if mounted locally.
mosquitto/data/
mosquitto/log/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Testing ---
.coverage
htmlcov/
.pytest_cache/
